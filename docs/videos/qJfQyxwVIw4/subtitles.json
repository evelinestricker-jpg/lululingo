ic particle","type":"Partikel","lvl":"N5"},{"w":"みんな","ro":"minna","da":"alle","en":"everyone","type":"Pronomen","lvl":"N5"},{"w":"食べたい","r":"たべたい","ro":"tabetai","da":"vil gerne spise","en":"want to eat","type":"Verbum","lvl":"N5"},{"w":"です","ro":"desu","da":"er (høflig form)","en":"is, am (polite)","type":"Kopula","lvl":"N5"},{"w":"。","p":true},{"w":"みんな","ro":"minna","da":"alle","en":"everyone","type":"Pronomen","lvl":"N5"},{"w":"で","ro":"de","da":"med, på (måde – fx »i alt«, »alle sammen«)","en":"with, by (means, e.g. 'in total', 'all together')","type":"Partikel","lvl":"N5"},{"w":"ラーメン","ro":"rāmen","da":"ramen (nudelsuppe)","en":"ramen (noodle soup)","type":"Substantiv","lvl":"N5"},{"w":"を","ro":"o","da":"objekt-partikel (det man gør noget ved)","en":"object particle","type":"Partikel","lvl":"N5"},{"w":"食べます","r":"たべます","ro":"tabemasu","da":"spiser (høflig)","en":"eat (polite)","type":"Verbum","lvl":"N5"},{"w":"。","p":true}]},{"n":20,"start":140.74,"end":145.595,"jp":"いただきます。おいしいです。","da":"Velbekomme! Det smager godt.","en":"Let's eat! It's delicious.","tokens":[{"w":"いただきます","ro":"itadakimasu","da":"siges før man spiser (»tak for maden«)","en":"said before eating","type":"Udtryk","lvl":"N5"},{"w":"。","p":true},{"w":"おいしい","ro":"oishii","da":"lækker, velsmagende","en":"delicious, tasty","type":"i-adjektiv","lvl":"N5"},{"w":"です","ro":"desu","da":"er (høflig form)","en":"is, am (polite)","type":"Kopula","lvl":"N5"},{"w":"。","p":true}]},{"n":21,"start":145.595,"end":153.5,"jp":"全部食べました。ごちそうさまでした。","da":"Vi spiste det hele. Tak for mad!","en":"We ate it all. Thank you for the meal!","tokens":[{"w":"全部","r":"ぜんぶ","ro":"zenbu","da":"alt, i alt","en":"all, everything","type":"Substantiv","lvl":"N5"},{"w":"食べました","r":"たべました","ro":"tabemashita","da":"spiste (høflig)","en":"ate (polite)","type":"Verbum","lvl":"N5"},{"w":"。","p":true},{"w":"ごちそうさまでした","ro":"gochisōsama deshita","da":"tak for mad (siges efter maden)","en":"thank you for the meal (said after eating)","type