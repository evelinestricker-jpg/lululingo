{
  "name": "lululingo",
  "private": true,
  "version": "1.0.0",
  "description": "Lululingo – lær japansk med Lulu",
  "scripts": {
    "build:sdk": "esbuild tools/sdk-entry.js --bundle --format=esm --platform=browser --minify --outfile=docs/vendor/anthropic.js",
    "serve": "node --use-system-ca tools/serve.js",
    "serve:lan": "node --use-system-ca tools/serve.js --lan",
    "build:piper": "esbuild tools/piper-entry.js --bundle --format=esm --splitting --platform=browser --minify --external:fs --external:path --outdir=docs/vendor/piper"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "esbuild": "0.25.0",
    "onnxruntime-web": "1.18.0"
  }
}
